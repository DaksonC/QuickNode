{
  "name": "@10565/quicknode-cli",
  "version": "3.0.0",
  "description": "Zero-dependency CLI to create Node.js APIs with clean architecture: Express, TypeScript or JavaScript, PostgreSQL, tests and linting ready.",
  "type": "module",
  "bin": {
    "qn": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/** --test-coverage-lines=80 test/*.test.js",
    "test:templates": "npm run build && node --test test/templates.e2e.test.js",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:check": "npm run build && node scripts/build-docs.mjs --check",
    "docs:serve": "node scripts/serve-docs.mjs",
    "eval:agents": "npm run build && node scripts/eval-agents.mjs",
    "verify": "npm run lint && npm run test:coverage && npm audit signatures && npm audit --omit=dev --audit-level=high",
    "lint": "eslint src test scripts docs-src",
    "lint:fix": "eslint src test scripts docs-src --fix",
    "format": "prettier --write src test scripts docs-src/*.mjs",
    "prepublishOnly": "npm run build",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:prerelease": "./scripts/release.sh prerelease",
    "release:tag": "./scripts/release.sh tag"
  },
  "keywords": [
    "nodejs",
    "node",
    "cli",
    "scaffold",
    "generator",
    "boilerplate",
    "template",
    "clean-architecture",
    "express",
    "typescript",
    "typescript-template",
    "javascript",
    "api",
    "rest-api",
    "postgresql",
    "zero-dependencies"
  ],
  "author": "Dakson C <daksonmendes@outlook.com>",
  "license": "MIT",
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.com/donate/?hosted_button_id=EA36NAFVH6LDY"
    }
  ],
  "homepage": "https://daksonc.github.io/QuickNode/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaksonC/QuickNode.git"
  },
  "bugs": {
    "url": "https://github.com/DaksonC/QuickNode/issues"
  },
  "files": [
    "dist",
    "templates",
    "!templates/*/node_modules",
    "!templates/*/package-lock.json",
    "!templates/*/.env",
    "!templates/*/dist",
    "!templates/*/coverage",
    "!templates/**/*.log",
    "!templates/**/*.sqlite",
    "!templates/**/.DS_Store"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
