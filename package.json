{
  "name": "@10565/quicknode-cli",
  "version": "1.1.0",
  "description": "A CLI tool to quickly bootstrap Node.js projects with pre-configured dependencies and clean architecture",
  "type": "module",
  "bin": {
    "qn": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/** --test-coverage-lines=80 test/*.test.js",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test",
    "prepublishOnly": "npm run build",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:prerelease": "./scripts/release.sh prerelease"
  },
  "keywords": [
    "nodejs",
    "cli",
    "template",
    "express",
    "typescript",
    "clean-architecture",
    "boilerplate"
  ],
  "author": "Dakson C <daksonmendes@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/DaksonC/QuickNode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaksonC/QuickNode.git"
  },
  "bugs": {
    "url": "https://github.com/DaksonC/QuickNode/issues"
  },
  "files": [
    "dist",
    "templates",
    "!templates/*/node_modules",
    "!templates/*/package-lock.json",
    "!templates/*/.env",
    "!templates/*/dist",
    "!templates/*/coverage",
    "!templates/**/*.log",
    "!templates/**/*.sqlite",
    "!templates/**/.DS_Store"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
