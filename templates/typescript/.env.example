# Database Configuration
# Supported types: postgresql, mysql, sqlite
# PostgreSQL is the default and recommended database
DB_TYPE=postgresql

# PostgreSQL Configuration (Default - works with Docker Compose)
# Optional: overrides the DB_* variables below
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@localhost:5432/quicknode_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=quicknode_db

# MySQL Configuration (when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=change-me
# DB_NAME=quicknode_db

# SQLite Configuration (when DB_TYPE=sqlite)
SQLITE_PATH=./database.sqlite

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret: `qn create` generates a random value in .env.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# API Configuration
API_VERSION=v1

# Logging Configuration
LOG_LEVEL=info
