{
  "name": "quicknode-app",
  "version": "1.0.0",
  "description": "QuickNode application with clean architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "check": "npx @10565/quicknode-cli@3 check",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
